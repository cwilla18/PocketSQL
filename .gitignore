# .gitignore for .NET projects (suitable for .NET 8, Visual Studio, VS Code, Rider)
# Based on GitHub's .NET/VisualStudio templates.

# Build results
[Bb]in/
[Oo]bj/
out/
artifacts/
publish/
TestResults/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# NuGet packages
*.nupkg
packages/
project.lock.json
project.fragment.lock.json
packages.lock.json
.nuget/

# Dotnet
*.dotCover
*.ncrunch*
*.coverage
*.coveragexml
*.cache
*.db

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Files built by popular Visual Studio add-ons
*.userprefs

# Resharper
_ReSharper*/
*.DotSettings.user

# Rider/IDE caches
/.idea/
/*.iml

# Deployable packages
*.zip
*.rar

# Azure build artifacts
publish/
*.Publish.xml

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.swp

# OS generated files
.DS_Store
Thumbs.db

# JetBrains Rider local history
.idea/

# Rider settings that should not be committed
.idea/*workspace.xml
.idea/*tasks.xml
.idea/dictionaries/
.idea/shelf/

# Local secrets (user secrets, environment files)
secrets.json
.env
.env.*.local

# npm/node (if front-end assets are present)
node_modules/

# VS installer artifacts
*.vsix

# Mono
*.pidb
*.userprefs

# Coverage & test results
coverage/
TestResults/

# Ignore NuGet package directories generated by dotnet restore if you use the global-packages folder
# (typically unnecessary; left here for completeness)
# ~/.nuget/packages

# End of .gitignore